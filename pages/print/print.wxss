.print-shell {
  min-height: 100vh;
  padding: 28rpx;
  background: #e9dfd4;
}

.print-toolbar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.toolbar-btn {
  flex: 1;
}

.a4-page {
  width: 100%;
  min-height: 1120rpx;
  padding: 48rpx 36rpx;
  background: #fff;
  color: #111;
  border: 1rpx solid #222;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.12);
}

.print-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 900;
}

.print-subtitle {
  margin-top: 8rpx;
  text-align: center;
  font-size: 28rpx;
}

.print-form-name {
  margin: 28rpx 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: 900;
}

.print-meta {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-bottom: 24rpx;
  font-size: 22rpx;
}

.print-table {
  border-top: 1rpx solid #222;
  border-left: 1rpx solid #222;
}

.print-row {
  display: flex;
  min-height: 64rpx;
  border-bottom: 1rpx solid #222;
}

.print-category {
  padding: 12rpx 14rpx;
  border-right: 1rpx solid #222;
  border-bottom: 1rpx solid #222;
  background: #f2f2f2;
  color: #111;
  font-weight: 900;
}

.print-label {
  width: 230rpx;
  padding: 14rpx;
  border-right: 1rpx solid #222;
  font-weight: 800;
}

.print-value {
  flex: 1;
  padding: 14rpx;
  border-right: 1rpx solid #222;
  word-break: break-all;
}

.print-health-block {
  border-right: 1rpx solid #222;
  border-bottom: 1rpx solid #222;
}

.print-health-title {
  padding: 14rpx;
  border-bottom: 1rpx solid #222;
  font-weight: 900;
}

.print-health-table {
  width: 100%;
}

.print-health-head,
.print-health-row {
  display: grid;
  grid-template-columns: 1.05fr 1.3fr 1.1fr 0.8fr 1.1fr 0.8fr;
}

.print-health-head text,
.print-health-row text {
  min-height: 48rpx;
  padding: 8rpx;
  border-right: 1rpx solid #222;
  border-bottom: 1rpx solid #222;
  font-size: 20rpx;
  word-break: break-all;
}

.print-health-head text {
  font-weight: 900;
  text-align: center;
}

.print-health-row:last-child text {
  border-bottom: 0;
}

.print-health-head text:last-child,
.print-health-row text:last-child {
  border-right: 0;
}

.print-image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.print-image {
  width: 190rpx;
  height: 140rpx;
  border: 1rpx solid #222;
  background: #fff;
}

.sign-row {
  display: flex;
  justify-content: space-between;
  margin-top: 72rpx;
  font-size: 24rpx;
}

.print-note {
  margin: 24rpx 4rpx 0;
  color: #6d5145;
  font-size: 24rpx;
  line-height: 1.7;
}
