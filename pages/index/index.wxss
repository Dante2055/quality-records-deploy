.home-page {
  padding-bottom: 140rpx;
}

.module-list {
  display: grid;
  gap: 20rpx;
  margin-top: 20rpx;
  padding-bottom: 8rpx;
}

.module-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  width: 100%;
  min-height: 150rpx;
  padding: 24rpx 26rpx;
}

.module-index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: #8b0f0f;
  color: #fffaf2;
  font-size: 28rpx;
  font-weight: 800;
}

.module-name {
  color: #2f211d;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.35;
  word-break: keep-all;
  overflow-wrap: normal;
  writing-mode: horizontal-tb;
}

.module-desc {
  margin-top: 8rpx;
  color: #80675c;
  font-size: 24rpx;
  line-height: 1.7;
}

.module-meta {
  margin-top: 10rpx;
  color: #8b0f0f;
  font-size: 24rpx;
  font-weight: 800;
}

.module-content {
  flex: 1;
  min-width: 0;
}

.module-arrow {
  color: #8b0f0f;
  font-size: 52rpx;
  line-height: 1;
}

.notice-card {
  padding: 28rpx;
}

.notice-title {
  color: #2f211d;
  font-size: 32rpx;
  font-weight: 900;
}

.notice-line {
  margin-top: 12rpx;
  color: #5e4337;
}

.compact-btn {
  margin-top: 24rpx;
}
