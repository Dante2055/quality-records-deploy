.records-page {
  padding-bottom: 140rpx;
}

.filter-card {
  display: grid;
  gap: 18rpx;
  margin-top: 24rpx;
  padding: 22rpx;
}

.record-list {
  display: grid;
  gap: 16rpx;
}

.record-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding: 24rpx;
}

.record-main {
  min-width: 0;
  flex: 1;
}

.record-title-main {
  color: #2f211d;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.25;
}

.record-title-sub {
  margin-top: 4rpx;
  color: #2f211d;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.35;
  word-break: break-all;
}

.record-meta {
  margin-top: 8rpx;
  color: #80675c;
  font-size: 24rpx;
}

.record-card .status {
  flex: 0 0 auto;
  margin-top: 2rpx;
}
