<view class="page">
  <view class="detail-head card">
    <view>
      <view class="tag">{{record.moduleName}}</view>
      <view class="page-title detail-title">{{record.title}}</view>
      <view class="page-subtitle">{{record.templateName}}</view>
    </view>
    <view class="status status-{{record.status}}">{{record.statusText}}</view>
  </view>

  <view class="section">
    <view class="section-title">记录信息</view>
    <view class="info-card card">
      <view class="info-row">
        <text class="info-label">{{fillerLabel}}</text>
        <text class="info-value">{{record.data.filledBy || record.createdByName || record.createdBy || '-'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">记录日期</text>
        <text class="info-value">{{record.recordDate || '-'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">批次号</text>
        <text class="info-value">{{record.batchNo || '-'}}</text>
      </view>
      <view class="info-row" wx:if="{{record.correctionOf}}">
        <text class="info-label">原记录编号</text>
        <text class="info-value">{{record.correctionOf}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">表单内容</view>
    <view class="info-card card">
      <view wx:for="{{displayFields}}" wx:key="name">
        <view wx:if="{{item.categoryTitle}}" class="detail-category">{{item.categoryTitle}}</view>
        <view class="health-detail" wx:if="{{item.type === 'healthChecks'}}">
          <view class="health-detail-title">{{item.label}}</view>
          <view class="health-detail-table" wx:if="{{item.healthChecks.length}}">
            <view class="health-detail-head">
              <text>检查时间</text>
              <text>检查单位</text>
              <text>检查项目</text>
              <text>检查结果</text>
              <text>采取措施</text>
              <text>备注</text>
            </view>
            <view class="health-detail-row" wx:for="{{item.healthChecks}}" wx:for-item="row" wx:key="index">
              <text>{{row.checkTime || '-'}}</text>
              <text>{{row.checkUnit || '-'}}</text>
              <text>{{row.checkItem || '-'}}</text>
              <text>{{row.checkResult || '-'}}</text>
              <text>{{row.measureTaken || '-'}}</text>
              <text>{{row.remarks || '-'}}</text>
            </view>
          </view>
          <view wx:else class="health-empty">暂无检查记录</view>
        </view>
        <view class="info-row" wx:elif="{{item.type !== 'image'}}">
          <text class="info-label">{{item.label}}</text>
          <text class="info-value">{{item.value || '-'}}</text>
        </view>
        <view class="info-row image-info-row" wx:else>
          <text class="info-label">{{item.label}}</text>
          <view class="info-value">
            <view wx:if="{{item.images.length}}" class="detail-image-list">
              <image
                class="detail-image"
                wx:for="{{item.images}}"
                wx:for-item="image"
                wx:for-index="imageIndex"
                wx:key="path"
                src="{{image.path}}"
                mode="aspectFill"
                data-name="{{item.name}}"
                data-index="{{imageIndex}}"
                bindtap="previewImage"
              />
            </view>
            <text wx:else>-</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{ccpNotice}}">
    <view class="ccp-result card">
      <view class="ccp-result-title">CCP 判定</view>
      <view>{{ccpNotice}}</view>
    </view>
  </view>

  <view class="section" wx:if="{{record.reviewedAt || record.reviewComment}}">
    <view class="section-title">审核信息</view>
    <view class="info-card card">
      <view class="info-row">
        <text class="info-label">审核人</text>
        <text class="info-value">{{record.reviewedBy || '-'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">审核意见</text>
        <text class="info-value">{{record.reviewComment || '-'}}</text>
      </view>
    </view>
  </view>

  <view class="detail-actions">
    <button wx:if="{{canAppendHealthCheck}}" class="primary-btn" bindtap="appendHealthCheck">新增年度检查</button>
    <button wx:if="{{canEdit}}" class="secondary-btn" bindtap="editRecord">编辑</button>
    <button wx:if="{{canSubmit}}" class="primary-btn" bindtap="submitRecord">提交审核</button>
    <button wx:if="{{canReview}}" class="primary-btn" bindtap="approveRecord">审核通过</button>
    <button wx:if="{{canReview}}" class="secondary-btn" bindtap="rejectRecord">退回修改</button>
    <button wx:if="{{canCorrect}}" class="secondary-btn" bindtap="correctRecord">发起更正</button>
    <button class="secondary-btn" bindtap="goPrint">A4 打印预览</button>
    <button wx:if="{{isHaccp}}" class="secondary-btn" bindtap="goHaccp">HACCP CCP 报告</button>
    <button wx:if="{{canDelete}}" class="danger-btn" bindtap="deleteRecord">删除记录</button>
  </view>
</view>
