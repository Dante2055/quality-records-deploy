<view class="page">
  <view class="tag">年度续检</view>
  <view class="page-title">新增年度检查</view>
  <view class="page-subtitle">{{employeeName || '未填写姓名'}}　员工号：{{employeeNo || '-'}}</view>

  <view class="form-card card section">
    <view class="field">
      <view class="field-label">检查时间 <text class="required">*</text></view>
      <picker mode="date" value="{{form.checkTime}}" data-key="checkTime" bindchange="onInput">
        <view class="picker-value">{{form.checkTime || '请选择日期'}}</view>
      </picker>
    </view>

    <view class="field">
      <view class="field-label">检查单位</view>
      <input class="input" value="{{form.checkUnit}}" placeholder="请输入检查单位" data-key="checkUnit" bindinput="onInput" />
    </view>

    <view class="field">
      <view class="field-label">检查项目 <text class="required">*</text></view>
      <input class="input" value="{{form.checkItem}}" placeholder="请输入检查项目" data-key="checkItem" bindinput="onInput" />
    </view>

    <view class="field">
      <view class="field-label">检查结果 <text class="required">*</text></view>
      <input class="input" value="{{form.checkResult}}" placeholder="请输入检查结果" data-key="checkResult" bindinput="onInput" />
    </view>

    <view class="field">
      <view class="field-label">采取措施</view>
      <input class="input" value="{{form.measureTaken}}" placeholder="请输入采取措施" data-key="measureTaken" bindinput="onInput" />
    </view>

    <view class="field">
      <view class="field-label">备注</view>
      <input class="input" value="{{form.remarks}}" placeholder="请输入备注" data-key="remarks" bindinput="onInput" />
    </view>
  </view>

  <view class="notice-card card">
    <view>本操作只追加年度健康检查明细，不修改员工基础档案信息。</view>
  </view>

  <view class="bottom-actions">
    <button class="primary-btn" bindtap="save">保存年度检查</button>
  </view>
</view>
