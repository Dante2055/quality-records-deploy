.bottom-actions {
  margin-top: 28rpx;
  padding-bottom: 44rpx;
}

.ccp-warning {
  margin-top: 22rpx;
  padding: 24rpx;
  background: #fff0e6;
  color: #9f2720;
  line-height: 1.7;
}

.ccp-warning-title {
  margin-bottom: 8rpx;
  font-weight: 900;
}

.history-card {
  margin-top: 22rpx;
  padding: 24rpx;
}

.history-title {
  margin-bottom: 16rpx;
  color: #2f211d;
  font-size: 30rpx;
  font-weight: 900;
}

.history-item {
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(139, 15, 15, 0.12);
}

.history-item:first-of-type {
  border-top: 0;
  padding-top: 0;
}

.history-main {
  color: #2f211d;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.5;
}

.history-meta {
  margin-top: 6rpx;
  color: #7b6962;
  font-size: 24rpx;
  line-height: 1.5;
}

.health-checks {
  display: grid;
  gap: 18rpx;
}

.health-check-row {
  padding: 18rpx;
  border: 1rpx solid rgba(139, 15, 15, 0.16);
  border-radius: 16rpx;
  background: #fffaf2;
}

.health-row-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
  color: #2f211d;
  font-size: 28rpx;
  font-weight: 900;
}

.health-row-remove {
  width: 112rpx;
  height: 54rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid rgba(139, 15, 15, 0.22);
  border-radius: 12rpx;
  background: #fff;
  color: #8b0f0f;
  font-size: 24rpx;
  line-height: 54rpx;
}

.health-grid {
  display: grid;
  gap: 14rpx;
}

.health-label {
  margin-bottom: 8rpx;
  color: #6d5145;
  font-size: 24rpx;
  font-weight: 800;
}

.health-add {
  width: 260rpx;
  height: 70rpx;
  margin: 0;
  padding: 0;
  border-radius: 14rpx;
  background: #8b0f0f;
  color: #fff;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 70rpx;
}

.field-category {
  margin: 12rpx 0 4rpx;
  padding: 14rpx 18rpx;
  border-left: 8rpx solid #8b0f0f;
  border-radius: 12rpx;
  background: #f7e7e4;
  color: #8b0f0f;
  font-size: 28rpx;
  font-weight: 900;
}

.radio-group {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  width: 100%;
}

.radio-option {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 72rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(139, 15, 15, 0.18);
  border-radius: 14rpx;
  background: #fffaf2;
  color: #2f211d;
  font-size: 28rpx;
}

.image-field {
  display: grid;
  gap: 16rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.image-item {
  width: 184rpx;
}

.image-thumb {
  width: 184rpx;
  height: 184rpx;
  display: block;
  border: 1rpx solid rgba(139, 15, 15, 0.2);
  border-radius: 14rpx;
  background: #fffaf2;
}

.image-remove {
  width: 184rpx;
  height: 58rpx;
  margin-top: 10rpx;
  padding: 0;
  border: 1rpx solid rgba(139, 15, 15, 0.22);
  border-radius: 12rpx;
  background: #fffaf2;
  color: #8b0f0f;
  font-size: 24rpx;
  line-height: 58rpx;
}

.image-upload {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 240rpx;
  height: 74rpx;
  margin: 0;
  border-radius: 14rpx;
  background: #8b0f0f;
  color: #fff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1;
  text-align: center;
}

.image-upload-hover {
  background: #6f0b0b;
}
