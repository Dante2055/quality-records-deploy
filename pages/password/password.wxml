<view class="page">
  <view class="tag">账号安全</view>
  <view class="page-title">修改密码</view>
  <view class="page-subtitle">当前用户：{{user.username}}</view>

  <view class="card form-card section">
    <view class="field">
      <text class="field-label">原密码</text>
      <input class="input" password value="{{oldPassword}}" bindinput="onOld" placeholder="请输入原密码" />
    </view>
    <view class="field">
      <text class="field-label">新密码</text>
      <input class="input" password value="{{newPassword}}" bindinput="onNew" placeholder="至少 6 位" />
    </view>
    <button class="primary-btn" bindtap="save">保存新密码</button>
  </view>
</view>
