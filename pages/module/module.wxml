<view class="page">
  <view class="tag">模块</view>
  <view class="page-title">{{module.name}}</view>
  <view class="page-subtitle">{{module.description}}</view>

  <view class="section">
    <view class="section-title">表单列表</view>
    <view class="form-list">
      <view class="list-card card" wx:for="{{forms}}" wx:key="slug" bindtap="goForm" data-slug="{{item.slug}}">
        <view>
          <view class="list-title">{{item.name}}</view>
          <view class="list-subtitle">最近记录 {{item.recordCount}} 条</view>
        </view>
        <view class="list-arrow">›</view>
      </view>
    </view>
  </view>
</view>
