.haccp-page {
  padding-bottom: 80rpx;
}

.filter-card {
  display: grid;
  gap: 18rpx;
  margin-top: 24rpx;
  padding: 22rpx;
}

.report-page {
  margin-top: 28rpx;
  padding: 28rpx;
  background: #fff;
  color: #111;
  border-color: #222;
}

.report-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 900;
}

.report-meta {
  margin-top: 12rpx;
  color: #222;
}

.ccp-table-head,
.ccp-table-row {
  display: grid;
  grid-template-columns: 1.4fr 1.2fr 1fr 1fr 1fr;
  border-left: 1rpx solid #222;
  border-top: 1rpx solid #222;
  font-size: 22rpx;
}

.ccp-table-head {
  margin-top: 24rpx;
  font-weight: 900;
}

.ccp-table-head text,
.ccp-table-row text {
  min-height: 56rpx;
  padding: 10rpx;
  border-right: 1rpx solid #222;
  border-bottom: 1rpx solid #222;
  word-break: break-all;
}

.report-section-title {
  margin-top: 30rpx;
  color: #111;
}

.action-item {
  padding: 14rpx 0;
  border-bottom: 1rpx solid #ddd;
  color: #111;
}

.report-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 24rpx;
}

.report-action-btn {
  min-width: 0;
  padding-left: 0;
  padding-right: 0;
}
