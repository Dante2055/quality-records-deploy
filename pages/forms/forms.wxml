<view class="page">
  <view class="tag">{{form.moduleName}}</view>
  <view class="page-title">{{form.name}}</view>

  <view class="action-row">
    <button class="primary-btn" bindtap="newRecord">新增记录</button>
  </view>

  <view class="section" wx:if="{{form.slug === 'critical-control-point-record'}}">
    <view class="ccp-card card">
      <view class="ccp-title">HACCP CCP 控制点</view>
      <view class="ccp-line">“制曲”是本表中的关键控制点项目；制曲温度 ≤ 40℃，湿度 60% - 100%。超标时必须填写纠偏措施。</view>
      <button class="secondary-btn compact-btn" bindtap="goHaccp">生成 CCP 报告</button>
    </view>
  </view>

  <view class="section">
    <view class="section-title">最近记录（{{records.length}}）</view>
    <view wx:if="{{records.length === 0}}" class="empty card">暂无记录</view>
    <view class="record-list" wx:else>
      <view class="record-card card" wx:for="{{records}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
        <view class="record-main">
          <view class="record-title-main">{{item.titleMain}}</view>
          <view class="record-title-sub">{{item.titleSub}}</view>
          <view class="record-meta">{{item.recordDate || '-'}} · {{item.createdByName || item.createdBy || '-'}}</view>
        </view>
        <view class="status status-{{item.status}}">{{item.statusText}}</view>
      </view>
    </view>
  </view>
</view>
