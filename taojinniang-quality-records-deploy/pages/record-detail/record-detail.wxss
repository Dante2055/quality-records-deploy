.detail-head {
  padding: 26rpx;
}

.detail-title {
  margin-top: 14rpx;
}

.info-card {
  display: grid;
  gap: 2rpx;
  overflow: hidden;
}

.info-row {
  display: flex;
  gap: 24rpx;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid rgba(76, 43, 32, 0.08);
  background: #fffaf2;
}

.info-row:last-child {
  border-bottom: 0;
}

.detail-category {
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid rgba(139, 15, 15, 0.1);
  background: #f7e7e4;
  color: #8b0f0f;
  font-weight: 900;
}

.health-detail {
  overflow-x: auto;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid rgba(76, 43, 32, 0.08);
  background: #fffaf2;
}

.health-detail-title {
  margin-bottom: 14rpx;
  color: #80675c;
  font-weight: 900;
}

.health-detail-table {
  border-top: 1rpx solid rgba(139, 15, 15, 0.2);
  border-left: 1rpx solid rgba(139, 15, 15, 0.2);
}

.health-detail-head,
.health-detail-row {
  display: grid;
  grid-template-columns: repeat(6, minmax(150rpx, 1fr));
  min-width: 900rpx;
}

.health-detail-head text,
.health-detail-row text {
  min-height: 56rpx;
  padding: 10rpx;
  border-right: 1rpx solid rgba(139, 15, 15, 0.2);
  border-bottom: 1rpx solid rgba(139, 15, 15, 0.2);
  word-break: break-all;
}

.health-detail-head text {
  background: #f7e7e4;
  color: #8b0f0f;
  font-weight: 900;
}

.health-empty {
  color: #80675c;
}

.info-label {
  width: 210rpx;
  flex: 0 0 auto;
  color: #80675c;
  font-weight: 800;
}

.info-value {
  flex: 1;
  color: #2f211d;
  word-break: break-all;
}

.image-info-row {
  align-items: flex-start;
}

.detail-image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.detail-image {
  width: 160rpx;
  height: 160rpx;
  border: 1rpx solid rgba(139, 15, 15, 0.18);
  border-radius: 12rpx;
  background: #fff;
}

.ccp-result {
  padding: 24rpx;
  background: #fff6eb;
  color: #5e4337;
  line-height: 1.7;
}

.ccp-result-title {
  margin-bottom: 8rpx;
  color: #8b0f0f;
  font-weight: 900;
}

.detail-actions {
  display: grid;
  gap: 18rpx;
  margin-top: 30rpx;
  padding-bottom: 52rpx;
}
