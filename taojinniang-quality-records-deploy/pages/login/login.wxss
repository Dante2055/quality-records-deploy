.auth-page .brand-card {
  margin-top: 16rpx;
}

.login-card {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  width: 100%;
  max-width: 100%;
  padding: 28rpx;
  margin-left: auto;
  margin-right: auto;
  overflow: hidden;
}

.login-field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  width: 100%;
}

.login-input {
  display: block;
  width: 100%;
  max-width: 100%;
  height: 76rpx;
  min-height: 76rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(76, 43, 32, 0.18);
  border-radius: 12rpx;
  background: #fff;
  color: #2f211d;
  font-size: 30rpx;
}

.login-main-btn {
  width: 340rpx;
  max-width: calc(100% - 80rpx);
  margin: 0 auto;
}

.auth-page .muted {
  width: 100%;
  line-height: 1.6;
  word-break: break-all;
}
