<view class="page home-page">
  <view class="brand-card">
    <image class="brand-logo" src="/images/logo.png" mode="aspectFill" />
    <view>
      <view class="brand-title">质量安全管理记录系统</view>
      <view class="brand-subtitle">阳江市桃金娘豆豉有限公司</view>
    </view>
  </view>

  <view class="section">
    <view class="page-title">业务模块</view>
    <view class="page-subtitle">按质量安全管理场景进入表单，数据暂存在本机缓存。</view>
  </view>

  <view class="module-list">
    <view class="module-card card" wx:for="{{modules}}" wx:key="slug" bindtap="goModule" data-slug="{{item.slug}}">
      <view class="module-index">{{item.sortOrder}}</view>
      <view class="module-content">
        <view class="module-name">{{item.name}}</view>
        <view class="module-desc">{{item.description}}</view>
        <view class="module-meta">{{item.forms.length}} 个表单</view>
      </view>
      <view class="module-arrow">›</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">核心提醒</view>
    <view class="notice-card card">
      <view class="notice-title">制曲 CCP 临界值</view>
      <view class="notice-line">温度 ≤ 40℃</view>
      <view class="notice-line">湿度 60% - 100%</view>
      <button class="primary-btn compact-btn" bindtap="goHaccp">查看 HACCP 报告</button>
    </view>
  </view>
</view>
