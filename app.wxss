page {
  min-height: 100%;
  background: #f7efe4;
  color: #2f211d;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
  font-size: 28rpx;
}

view,
text,
input,
textarea,
picker,
button {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
}

.page-title {
  margin: 16rpx 0 10rpx;
  color: #2f211d;
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1.25;
}

.page-subtitle {
  color: #80675c;
  line-height: 1.7;
}

.brand-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(139, 15, 15, 0.12);
  border-radius: 18rpx;
  background: #fffaf2;
  box-shadow: 0 12rpx 36rpx rgba(79, 43, 29, 0.08);
}

.brand-logo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 18rpx;
  flex: 0 0 auto;
}

.brand-title {
  color: #2f211d;
  font-size: 32rpx;
  font-weight: 800;
}

.brand-subtitle {
  margin-top: 6rpx;
  color: #8b0f0f;
  font-size: 24rpx;
}

.card {
  border: 1rpx solid rgba(139, 15, 15, 0.12);
  border-radius: 18rpx;
  background: #fffaf2;
  box-shadow: 0 12rpx 36rpx rgba(79, 43, 29, 0.08);
}

.section {
  margin-top: 28rpx;
}

.section-title {
  margin-bottom: 16rpx;
  color: #2f211d;
  font-size: 34rpx;
  font-weight: 800;
}

.muted {
  color: #80675c;
}

.tag {
  display: inline-flex;
  width: fit-content;
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(139, 15, 15, 0.14);
  border-radius: 999rpx;
  background: #fff3e8;
  color: #8b0f0f;
  font-size: 24rpx;
  font-weight: 700;
}

.primary-btn,
.secondary-btn,
.danger-btn {
  width: 100%;
  min-height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 88rpx;
}

.primary-btn {
  background: #8b0f0f;
  color: #fffaf2;
}

.secondary-btn {
  border: 1rpx solid rgba(139, 15, 15, 0.22);
  background: #fffaf2;
  color: #8b0f0f;
}

.danger-btn {
  background: #f7e7e4;
  color: #9f2720;
}

.form-card {
  display: grid;
  gap: 24rpx;
  padding: 24rpx;
}

.field {
  display: grid;
  gap: 10rpx;
}

.field-label {
  color: #3d2a24;
  font-size: 26rpx;
  font-weight: 800;
}

.required {
  color: #8b0f0f;
}

.input,
.textarea,
.picker-value {
  width: 100%;
  min-height: 84rpx;
  border: 1rpx solid rgba(76, 43, 32, 0.18);
  border-radius: 14rpx;
  background: #fff;
  color: #2f211d;
  padding: 18rpx 20rpx;
  font-size: 30rpx;
}

.textarea {
  min-height: 160rpx;
}

.readonly {
  background: #f4eadf;
  color: #6d5145;
}

.row {
  display: flex;
  gap: 18rpx;
}

.row > view,
.row > button {
  flex: 1;
}

.status {
  display: inline-flex;
  width: fit-content;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.status-draft {
  background: #eee5da;
  color: #6d5145;
}

.status-submitted {
  background: #fff0c9;
  color: #8a5d00;
}

.status-approved {
  background: #e8f1df;
  color: #3e6b1e;
}

.status-rejected {
  background: #f7e7e4;
  color: #9f2720;
}

.empty {
  padding: 48rpx 28rpx;
  text-align: center;
  color: #80675c;
}

@media print {
  page {
    background: #fff;
  }
}
